# Kroger developer credentials: register an app at https://developer.kroger.com
# (scope needed: product.compact)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Walmart Affiliate API (https://walmart.io):
# 1. Run `python -m aislescout walmart-keygen` and upload the printed public key
#    to your walmart.io application.
# 2. Paste the Consumer ID walmart.io gives you (use the production one).
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
# Optional: defaults to backend/keys/walmart_private_key.pem
WALMART_PRIVATE_KEY_PATH=
# Optional: Impact publisher id, only needed for affiliate commission links
WALMART_PUBLISHER_ID=

# Set to 1 to serve labeled, made-up sample data instead of calling real APIs
# (same as `aislescout serve --demo`).
AISLESCOUT_DEMO=
# Comma-separated origins allowed to call the API directly (default http://localhost:3000)
AISLESCOUT_CORS_ORIGINS=
